<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.linuxuniverseofficial.coastalchaos">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <application android:label="Coastal Chaos: Sunset Shores" android:icon="@mipmap/launcher"
        android:roundIcon="@mipmap/launcher" android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity android:name=".GameActivity" android:exported="true" android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
